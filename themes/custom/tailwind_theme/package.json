{
    "name": "tailwind_theme",
    "version": "1.0.0",
    "description": "Drupal theme with Tailwind CSS",
    "main": "index.js",
    "scripts": {
        "build": "tailwindcss -i ./src/input.css -o ./css/style.css",
        "watch": "tailwindcss -i ./src/input.css -o ./css/style.css --watch"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.1",
        "postcss": "^8.4.35",
        "autoprefixer": "^10.4.18"
    }
}