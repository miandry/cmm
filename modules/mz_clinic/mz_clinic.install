/**
 * Add extended fields to Service content type.
 */
function mz_clinic_update_9008(): void {
  _mz_clinic_install_configs([
    'taxonomy.vocabulary.categorie_service',
    'field.storage.node.field_category',
    'field.storage.node.field_icon',
    'field.storage.node.field_duration',
    'field.storage.node.field_preparation',
    'field.storage.node.field_practitioners',
    'field.storage.node.field_image',
    'field.field.node.service.field_category',
    'field.field.node.service.field_image',
    'field.field.node.service.field_icon',
    'field.field.node.service.field_duration',
    'field.field.node.service.field_preparation',
    'field.field.node.service.field_practitioners',
    'core.entity_form_display.node.service.default',
    'core.entity_view_display.node.service.default',
  ]);

  $prix = \Drupal\field\Entity\FieldConfig::loadByName('node', 'service', 'field_prix');
  if ($prix) {
    $prix->setLabel('Tarif');
    $prix->setRequired(FALSE);
    $prix->setDescription('Tarif du service (Ar), optionnel.');
    $prix->save();
  }

  $description = \Drupal\field\Entity\FieldConfig::loadByName('node', 'service', 'field_description');
  if ($description) {
    $description->setDescription('Description détaillée de la prestation (corps).');
    $description->save();
  }
}

/**
 * Creates default taxonomy terms for practitioner types.
 */
function _mz_clinic_seed_type_praticien_terms(): void {
  $terms = [
    'Médecin',
    'Infirmier(ère)',
    'Kinésithérapeute',
    'Sage-femme',
    'Dentiste',
    'Psychologue',
    'Laborantin',
    'Autre',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($terms as $name) {
    $existing = $storage->loadByProperties([
      'vid' => 'type_praticien',
      'name' => $name,
    ]);
    if ($existing) {
      continue;
    }
    $storage->create([
      'vid' => 'type_praticien',
      'name' => $name,
    ])->save();
  }
}

/**
 * Replaces user-based practitioners field with node reference on service.
 */
function _mz_clinic_migrate_service_practitioners_field(): void {
  $field = \Drupal\field\Entity\FieldConfig::loadByName('node', 'service', 'field_practitioners');
  if ($field) {
    $field->delete();
  }

  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_practitioners');
  if ($storage && $storage->getSetting('target_type') === 'user') {
    $storage->delete();
  }
}

/**
 * Create Praticien content type and repoint service practitioners field.
 */
function mz_clinic_update_9009(): void {
  _mz_clinic_migrate_service_practitioners_field();

  _mz_clinic_install_configs([
    'taxonomy.vocabulary.type_praticien',
    'node.type.praticien',
    'field.storage.node.field_type_praticien',
    'field.storage.node.field_specialite',
    'field.storage.node.field_compte_utilisateur',
    'field.storage.node.field_titre_civilite',
    'field.field.node.praticien.field_type_praticien',
    'field.field.node.praticien.field_specialite',
    'field.field.node.praticien.field_titre_civilite',
    'field.field.node.praticien.field_description',
    'field.field.node.praticien.field_image',
    'field.field.node.praticien.field_phone',
    'field.field.node.praticien.field_mail',
    'field.field.node.praticien.field_compte_utilisateur',
    'field.field.node.praticien.field_actif',
    'field.storage.node.field_practitioners',
    'field.field.node.service.field_practitioners',
    'core.entity_form_display.node.praticien.default',
    'core.entity_view_display.node.praticien.default',
    'core.entity_form_display.node.service.default',
    'core.entity_view_display.node.service.default',
  ]);

  _mz_clinic_seed_type_praticien_terms();
}

/**
 * Grant praticien content permissions to clinic roles.
 */
function mz_clinic_update_9010(): void {
  $permissions = [
    'administer clinic practitioners',
    'create praticien content',
    'edit any praticien content',
    'delete any praticien content',
    'view praticien content',
  ];

  foreach (['gerant', 'webmaster', 'administrator'] as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if (!$role) {
      continue;
    }
    foreach ($permissions as $permission) {
      if (!$role->hasPermission($permission)) {
        $role->grantPermission($permission);
      }
    }
    $role->save();
  }

  foreach (['caissier', 'assistant'] as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if (!$role) {
      continue;
    }
    if (!$role->hasPermission('view praticien content')) {
      $role->grantPermission('view praticien content');
    }
    $role->save();
  }
}

