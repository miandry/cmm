/**
 * Allow service nodes in commande line items and create caisse services page alias.
 */
function mz_clinic_update_9013(): void {
  $field = \Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'commande', 'field_article');
  if ($field) {
    $settings = $field->getSettings();
    $settings['handler_settings']['target_bundles']['service'] = 'service';
    $field->setSettings($settings);
    $field->save();
  }

  _mz_clinic_create_vue_page('Caisse services', '/caisse/services');
}

/**
 * Allow caisse roles to create praticiens from the services checkout.
 */
function mz_clinic_update_9014(): void {
  foreach (['caissier', 'assistant', 'gerant'] as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if (!$role) {
      continue;
    }
    if (!$role->hasPermission('create praticien content')) {
      $role->grantPermission('create praticien content');
    }
    $role->save();
  }
}
